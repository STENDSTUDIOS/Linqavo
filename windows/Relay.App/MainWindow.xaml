<Window x:Class="Linqavo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{StaticResource WindowSolidBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="TitleStrip" Height="40" Background="{StaticResource WindowSolidBrush}" FlowDirection="LeftToRight">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <ContentControl Template="{StaticResource LinqavoMark}" Foreground="{StaticResource AccentBrush}"
                                IsTabStop="False" IsHitTestVisible="False"/>
                <TextBlock x:Name="WindowTitle" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
        <ContentControl x:Name="Workspace" Grid.Row="1" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Padding="8,14" Background="{StaticResource FillTertiary}">
            <Button x:Name="HomeNav" VerticalAlignment="Top" Click="OnHome" MinWidth="48" Height="48">
                <ContentControl Template="{StaticResource LinqavoMark}" Foreground="{StaticResource AccentBrush}"
                                IsTabStop="False" IsHitTestVisible="False"/>
            </Button>
            <Button x:Name="SettingsNav" VerticalAlignment="Bottom" Click="OnSettings" MinWidth="48" MinHeight="56" Padding="6">
                <StackPanel Spacing="4"><FontIcon Glyph="&#xE713;"/><TextBlock x:Name="NavSettingsLabel" FontSize="12"/></StackPanel>
            </Button>
        </Grid>
        <ScrollViewer Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid x:Name="Dashboard" SizeChanged="OnDashboardSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition x:Name="RightColumn" Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="DeviceColumn" Padding="24" Spacing="20">
                    <Button x:Name="DashboardUpdate" Visibility="Collapsed" Click="OnReleaseAction"/>
                    <TextBlock x:Name="DevicesTitle" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <Border x:Name="SelectedDevice" Visibility="Collapsed" CornerRadius="12"
                            Background="{StaticResource AccentFaintBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="16">
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8EA;" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Column="1" x:Name="SelectedName" FontSize="17" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="IdlePanel" VerticalAlignment="Center" Spacing="10">
                        <TextBlock x:Name="IdleHeadline" Style="{StaticResource HeadlineText}" />
                        <TextBlock x:Name="IdleBody" Style="{StaticResource FootnoteText}"
                                   Margin="6,0,6,6" />

                        <!-- Phones that are already announcing themselves, offered
                             before anything has to be typed or aimed at a camera. The
                             app has known about them since it started; hiding them
                             behind "enter a code" asked people to read two digits off a
                             screen the app was already looking at. One click is the
                             whole pairing when this list is not empty. -->
                        <StackPanel x:Name="IdleFoundPanel" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="IdleFoundHeader" Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource LabelTertiary}"
                                       HorizontalAlignment="Center" />
                            <StackPanel x:Name="IdleFoundList" Spacing="6" />
                        </StackPanel>

                        <!-- One accented action for when the list is empty or the phone
                             is not announcing: scanning is what almost everyone does,
                             so typing a code stays a quiet text action underneath. -->
                        <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}"
                                Click="OnScanClick" />
                        <Button x:Name="EnterCodeButton" Style="{StaticResource QuietButton}"
                                Click="OnEnterCodeClick" />
                    </StackPanel>

                    <!-- Scanning ────────────────────────────────────────-->
                    <StackPanel x:Name="ScanPanel" VerticalAlignment="Center" Spacing="12"
                                Visibility="Collapsed">
                        <Grid Height="252">
                            <Border CornerRadius="{StaticResource CardCorner}"
                                    Background="#14171D"
                                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
                                <Border CornerRadius="15">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,10000,250" />
                                    </Border.Clip>
                                    <!-- FlowDirection is pinned. Camera frames are not
                                         UI: on a Persian (or any RTL) Windows the
                                         window's RightToLeft flow mirrors everything in
                                         its subtree, including this Image, so the
                                         preview came out flipped while the Windows
                                         Camera app looked normal (issue #40). -->
                                    <Image x:Name="PreviewImage" Stretch="UniformToFill"
                                           FlowDirection="LeftToRight" />
                                </Border>
                            </Border>

                            <!-- An aiming frame. Without one the user has no idea how
                                 close to hold the phone, and a preview with nothing
                                 drawn on it looks like it is not doing anything. -->
                            <Grid x:Name="Reticle" Width="150" Height="150"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsHitTestVisible="False">
                                <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2.5"
                                        CornerRadius="14" Opacity="0.9" />
                            </Grid>
                        </Grid>

                        <TextBlock x:Name="ScanHintText" Style="{StaticResource FootnoteText}" />
                        <Button x:Name="ScanCancelButton" Style="{StaticResource SecondaryButton}"
                                Click="OnCancelClick" />
                    </StackPanel>

                    <!-- Manual code ────────────────────────────────────────-->
                    <StackPanel x:Name="CodePanel" VerticalAlignment="Center" Spacing="12"
                                Visibility="Collapsed">
                        <!-- Two characters wide, because two digits is what the phone
                             shows. A box captioned "the 8-character code" in front of a
                             phone showing "42" reads as "these two apps do not go
                             together", and people stop there. -->
                        <TextBox x:Name="CodeBox" PlaceholderText="00" MaxLength="2"
                                 InputScope="Number"
                                 FontSize="{StaticResource SizeCode}"
                                 FontFamily="{StaticResource FontMono}"
                                 TextAlignment="Center" CharacterSpacing="150"
                                 CornerRadius="{StaticResource ControlCorner}" MinHeight="64"
                                 Background="{StaticResource FillSecondary}"
                                 Foreground="{StaticResource LabelPrimary}"
                                 BorderBrush="{StaticResource HairlineBrush}"
                                 VerticalContentAlignment="Center"
                                 TextChanged="OnCodeChanged" />
                        <!-- Says what is wrong with what you typed, as you type it,
                             rather than after you commit to it. -->
                        <TextBlock x:Name="CodeHintText" Style="{StaticResource FootnoteText}" />

                        <!-- Every phone currently announcing itself, with the code it
                             is showing. Typing is then a convenience rather than the
                             only way in, and the two screens can be checked against
                             each other without trusting either app's prose. Rows are
                             built in code; see PopulateFoundList. -->
                        <StackPanel x:Name="FoundPanel" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="FoundHeader" Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource LabelTertiary}" />
                            <StackPanel x:Name="FoundList" Spacing="6" />
                        </StackPanel>

                        <Button x:Name="CodeConnectButton" Style="{StaticResource PrimaryButton}"
                                IsEnabled="False" Click="OnCodeConnectClick" />
                        <!-- The long code is still accepted, for a phone that could not
                             announce itself at all. Named by what the user would be
                             looking at rather than by its length. -->
                        <HyperlinkButton x:Name="CodeModeLink" HorizontalAlignment="Center"
                                         Click="OnCodeModeClick" />
                        <Button x:Name="CodeCancelButton" Style="{StaticResource QuietButton}"
                                Click="OnCancelClick" />
                    </StackPanel>

                    <!-- Working ────────────────────────────────────────-->
                    <StackPanel x:Name="BusyPanel" VerticalAlignment="Center" Spacing="16"
                                Visibility="Collapsed">
                        <ProgressRing IsActive="True" Width="34" Height="34"
                                      Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="BusyText" Style="{StaticResource BodyText}" />
                        <TextBlock x:Name="BusyDetailText" Style="{StaticResource FootnoteText}" />
                        <!-- Anything that can take time needs a way out of it — and the
                             way out has to actually undo the attempt, not just stop
                             looking at it. -->
                        <Button x:Name="BusyCancelButton" Style="{StaticResource QuietButton}"
                                Click="OnBusyCancelClick" />
                    </StackPanel>

                    <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center" Spacing="12"
                                Visibility="Collapsed">
                        <Grid HorizontalAlignment="Center" Width="60" Height="60" Margin="0,0,0,4">
                            <Ellipse Width="60" Height="60" Fill="{StaticResource DangerSoftBrush}" />
                            <Ellipse Width="14" Height="14" Fill="{StaticResource DangerBrush}" />
                        </Grid>
                        <!-- Errors get a headline that names the problem and a body that
                             says what to do about it, instead of one undifferentiated
                             paragraph the user has to parse under stress. -->
                        <TextBlock x:Name="ErrorTitle" Style="{StaticResource HeadlineText}"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock x:Name="ErrorText" Style="{StaticResource FootnoteText}"
                                   Margin="4,0,4,0" />
                        <Button x:Name="ErrorPrimaryButton" Style="{StaticResource PrimaryButton}"
                                Margin="0,8,0,0" Click="OnErrorPrimaryClick" />
                        <Button x:Name="ErrorDismissButton" Style="{StaticResource QuietButton}"
                                Click="OnDismissClick" />
                    </StackPanel>
                </StackPanel>
                <Grid x:Name="SessionColumn" Grid.Column="1" Background="{StaticResource SessionSurface}" Padding="24">
                    <Canvas x:Name="SessionRings" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Width="100" Height="92">
                        <Canvas.Clip><RectangleGeometry Rect="0,0,100,92"/></Canvas.Clip>
                        <Ellipse Width="145" Height="145" Canvas.Left="32" Canvas.Top="-95" Stroke="{StaticResource AccentSoftBrush}"/>
                        <Ellipse Width="195" Height="195" Canvas.Left="7" Canvas.Top="-120" Stroke="{StaticResource AccentSoftBrush}"/>
                    </Canvas>
                    <StackPanel x:Name="SessionSummary" Spacing="16">
                        <ContentControl Template="{StaticResource LinqavoMark}" Foreground="{StaticResource AccentBrush}"
                                        IsTabStop="False" IsHitTestVisible="False" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusChipText" FontWeight="SemiBold" FontSize="23" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <StackPanel x:Name="ConnectedPanel" VerticalAlignment="Center" Spacing="8"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="ConnectedText" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="ConnectedDetailText" Style="{StaticResource MonoText}"
                                       HorizontalAlignment="Center" />

                            <!-- What the tunnel is carrying, from the adapter's own
                                 counters. Rates on top because they answer "is it working
                                 right now"; totals and latency underneath because they
                                 answer "has it been working". -->
                            <Border x:Name="StatsCard" CornerRadius="{StaticResource SunkenCorner}"
                                    Background="{StaticResource FillSunken}"
                                    Padding="14,10" Margin="0,10,0,0">
                                <Grid ColumnSpacing="10" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="StatDownRate" Grid.Row="0" Grid.Column="0"
                                               Style="{StaticResource MonoText}" />
                                    <TextBlock x:Name="StatUpRate" Grid.Row="0" Grid.Column="1"
                                               Style="{StaticResource MonoText}"
                                               HorizontalAlignment="Right" />

                                    <TextBlock x:Name="StatDownTotal" Grid.Row="1" Grid.Column="0"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource LabelTertiary}" />
                                    <TextBlock x:Name="StatUpTotal" Grid.Row="1" Grid.Column="1"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource LabelTertiary}"
                                               HorizontalAlignment="Right" />

                                    <TextBlock x:Name="StatLatency" Grid.Row="2" Grid.Column="0"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource LabelTertiary}" />
                                    <TextBlock x:Name="StatDuration" Grid.Row="2" Grid.Column="1"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource LabelTertiary}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <Border x:Name="ReconnectingBanner" Visibility="Collapsed"
                                    CornerRadius="{StaticResource SunkenCorner}"
                                    Background="{StaticResource WarningSoftBrush}"
                                    Padding="12,8" Margin="0,8,0,0">
                                <TextBlock x:Name="ReconnectingText" Style="{StaticResource FootnoteText}"
                                           Foreground="{StaticResource WarningBrush}" />
                            </Border>

                            <Button x:Name="DisconnectButton" Style="{StaticResource SecondaryButton}"
                                    Margin="0,14,0,0" Click="OnDisconnectClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
        <ScrollViewer x:Name="SettingsPage" Grid.Column="1" HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel MaxWidth="800" Padding="24,16,24,32" Spacing="16" HorizontalAlignment="Stretch">
                <TextBlock x:Name="SettingsTitle" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEA18;" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="ProtectionHeading" Style="{StaticResource SettingsHeading}"/>
                        </StackPanel>
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="AdvancedLeakLabel" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LeakDescription" TextWrapping="Wrap" Foreground="{StaticResource LabelTertiary}" FontSize="13"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AdvancedLeakToggle" Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                                          AutomationProperties.LabeledBy="{Binding ElementName=AdvancedLeakLabel}" Toggled="OnLeakBlockToggled"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource HairlineBrush}"/>
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="AdvancedKillSwitchLabel" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HoldDescription" TextWrapping="Wrap" Foreground="{StaticResource LabelTertiary}" FontSize="13"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AdvancedKillSwitchToggle" Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                                          AutomationProperties.LabeledBy="{Binding ElementName=AdvancedKillSwitchLabel}" Toggled="OnKillSwitchToggled"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE770;" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="ApplicationHeading" Style="{StaticResource SettingsHeading}"/>
                        </StackPanel>
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="AdvancedStartupLabel" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AdvancedStartupToggle" Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                                          AutomationProperties.LabeledBy="{Binding ElementName=AdvancedStartupLabel}" Toggled="OnStartupToggled"/>
                        </Grid>
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="AdvancedVersionLabel" VerticalAlignment="Center" Foreground="{StaticResource LabelTertiary}"/>
                            <TextBlock x:Name="AdvancedVersionValue" Grid.Column="1" HorizontalAlignment="Right" IsTextSelectionEnabled="True"
                                       Style="{StaticResource MonoText}" FlowDirection="LeftToRight" TextWrapping="Wrap"/>
                        </Grid>
                        <Button x:Name="ReleaseAction" Click="OnReleaseAction"/>
                        <TextBlock x:Name="ReleaseMessage" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="AdvancedAddressLabel" VerticalAlignment="Center" Foreground="{StaticResource LabelTertiary}"/>
                            <TextBlock x:Name="AdvancedAddressValue" Grid.Column="1" HorizontalAlignment="Right" IsTextSelectionEnabled="True"
                                       Style="{StaticResource MonoText}" FlowDirection="LeftToRight" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE9D9;" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="AdvancedLogsLabel" Style="{StaticResource SettingsHeading}"/>
                        </StackPanel>
                        <Border CornerRadius="{StaticResource SunkenCorner}" Background="{StaticResource WindowSolidBrush}" Padding="14">
                            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText" Style="{StaticResource MonoText}" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="AdvancedLogsShare" Style="{StaticResource SecondaryButton}" Padding="12,0" Click="OnShareLogsClick"/>
                            <Button x:Name="AdvancedLogsClear" Style="{StaticResource QuietButton}" Padding="12,0" Click="OnClearLogsClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>
        </ContentControl>
        <Grid x:Name="VerificationOverlay" Grid.Row="1" Background="#AD080D15" Visibility="Collapsed"
              TabFocusNavigation="Cycle" Padding="16">
            <Border x:Name="VerificationCard" Style="{StaticResource SettingsCard}" MaxWidth="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" IsTabStop="False">
                    <StackPanel Spacing="16" Padding="24">
                        <FontIcon Glyph="&#xE928;" FontSize="28" HorizontalAlignment="Left" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="VerifyTitle" Style="{StaticResource TitleText}" TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level1" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="VerifyInstruction" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource WindowSolidBrush}" Padding="14" CornerRadius="{StaticResource SunkenCorner}">
                            <TextBlock x:Name="VerifyPin" FontFamily="{StaticResource FontMono}" FontSize="17" Foreground="{StaticResource AccentBrush}"
                                       FlowDirection="LeftToRight" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                        </Border>
                        <Button x:Name="VerifyMatch" TabIndex="1" Style="{StaticResource PrimaryButton}" Click="OnVerifyMatch"/>
                        <Button x:Name="VerifyCancel" TabIndex="0" Style="{StaticResource SecondaryButton}" Click="OnVerifyCancel"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
