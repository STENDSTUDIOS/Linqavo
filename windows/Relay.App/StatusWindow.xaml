<Window x:Class="Linqavo.App.StatusWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Surface" Background="{StaticResource WindowSolidBrush}">
        <Grid x:Name="Card" Padding="16,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="Mark" Template="{StaticResource LinqavoMark}" VerticalAlignment="Center"
                            IsTabStop="False" IsHitTestVisible="False"/>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock x:Name="Status" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="Detail" Foreground="{StaticResource LabelSecondary}" TextWrapping="Wrap"/>
                <TextBlock x:Name="Rates" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="OpenButton" Style="{StaticResource CaptionButton}" Content="&#xE8A7;" Click="OpenDashboard"/>
                <Button x:Name="HideButton" Style="{StaticResource CaptionButton}" Content="&#xE711;" Click="HideMini"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
